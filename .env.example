# ============================================
# SIGO - entorno local / SIGO-TEST
# ============================================
# Usa las credenciales PostgreSQL del proyecto SIGO-TEST.
# NO coloques aquí las credenciales de producción cuando estés probando seguridad.
DATABASE_URL=jdbc:postgresql://HOST_TEST:PORT/postgres
DATABASE_USER=USUARIO_TEST
DATABASE_PASSWORD=PASSWORD_DB_TEST

CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:5173

# JWT HS256: usa al menos 32 bytes aleatorios.
JWT_SECRET=reemplaza-por-un-secreto-aleatorio-de-al-menos-32-bytes
JWT_ISSUER=sigo-api-test
JWT_EXPIRATION_SECONDS=28800

# Solo para inicializar 3 cuentas en SIGO-TEST.
# Después del primer arranque correcto vuelve a false.
SIGO_TEST_BOOTSTRAP_ENABLED=false
SIGO_TEST_OPERADOR_CODIGO=2396
SIGO_TEST_OPERADOR_PASSWORD=
SIGO_TEST_CONTROLADOR_CODIGO=287
SIGO_TEST_CONTROLADOR_PASSWORD=
SIGO_TEST_SUPERVISOR_CODIGO=550
SIGO_TEST_SUPERVISOR_PASSWORD=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
